# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Admin(lar)ning Telegram ID raqami(lari), vergul bilan ajratib yozing
# ID ni bilish uchun @userinfobot ga /start bosing
ADMIN_IDS=123456789,987654321

# Google Cloud Service Account ma'lumotlari (Sheets API uchun)
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# Google Sheets jadval ID (jadval linkidagi /d/ va /edit orasidagi qism)
GOOGLE_SHEET_ID=

# Google OAuth (shaxsiy Drive'ga pasport rasmlarini yuklash uchun)
# Sozlash: README.md dagi "Google Drive (rasm ko'rsatish)" bo'limiga qarang
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
