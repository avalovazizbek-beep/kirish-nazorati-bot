# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Admin(lar)ning Telegram ID raqami(lari), vergul bilan ajratib yozing
# ID ni bilish uchun @userinfobot ga /start bosing
ADMIN_IDS=123456789,987654321

# Google Cloud Service Account ma'lumotlari (Sheets API uchun)
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# Google Sheets jadval ID (jadval linkidagi /d/ va /edit orasidagi qism)
GOOGLE_SHEET_ID=

# Google OAuth (shaxsiy Drive'ga pasport rasmlarini yuklash uchun)
# Sozlash: README.md dagi "Google Drive (rasm ko'rsatish)" bo'limiga qarang
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Kerio Control API (tasdiqlangan foydalanuvchini avtomatik yaratish uchun)
KERIO_URL=https://172.17.0.22:4081
KERIO_API_PATH=/admin/api/jsonrpc/
KERIO_USERNAME=
KERIO_PASSWORD=
KERIO_APPLICATION_NAME=Telegram Bot
KERIO_APPLICATION_VENDOR=SIES
KERIO_APPLICATION_VERSION=1.0
# Kerio serveri self-signed sertifikat bilan ishlasa true qoldiring (faqat ichki tarmoq uchun)
KERIO_ALLOW_SELF_SIGNED=true
# true bo'lsa - real user yaratilmaydi, faqat yuboriladigan so'rov konsolga chiqariladi
KERIO_DRY_RUN=true
# Yangi ro'yxatdan o'tgan foydalanuvchilar qo'shiladigan Kerio guruhi nomi
KERIO_STUDENT_GROUP_NAME=Студенты
